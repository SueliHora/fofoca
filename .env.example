# ==============================================================================
# Fofoca Transcriptor - Environment Configuration Template
# Copy this file to .env and adjust the variables as needed.
# ==============================================================================

# --- Server & Network Settings ---
# Host IP address for the Gradio Web Server (use 127.0.0.1 for local only, 0.0.0.0 for LAN exposure)
GRADIO_SERVER_NAME=127.0.0.1

# Port for the Gradio Web UI
GRADIO_SERVER_PORT=7860

# --- Whisper (Speech-to-Text) Settings ---
# Default Whisper model to load on launch: tiny | base | small | medium | large
WHISPER_DEFAULT_MODEL=base

# Directory where transcribed .txt files will be saved
AUDIO_TO_TEXT_OUTPUT_DIR=audio-to-text/output

# Directory where input media files for CLI batch processing are placed
AUDIO_TO_TEXT_INPUT_DIR=audio-to-text/input

# --- Piper TTS (Text-to-Speech) Settings ---
# Directory containing local Piper ONNX models (*.onnx and *.onnx.json)
PIPER_MODELS_DIR=text-to-audio/models

# Default voice code: pt (Portuguese - Faber) | en (English - Lessac)
PIPER_DEFAULT_LANGUAGE=pt

# Directory where synthesized .wav audio files will be saved
TEXT_TO_AUDIO_OUTPUT_DIR=text-to-audio/output

# Directory where input .txt files for CLI batch speech synthesis are placed
TEXT_TO_AUDIO_INPUT_DIR=text-to-audio/input
